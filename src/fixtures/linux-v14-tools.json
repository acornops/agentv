  {
    "name": "restart_service",
    "description": "Restart one exact locally allowlisted systemd service through the privileged helper. First call get_service for the same unit and copy its restart_preconditions exactly into the expected_* fields. After PRECONDITION_FAILED, call get_service again before requesting a new restart; never guess the preconditions.",
    "capability": "write",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 9,
          "maxLength": 263,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]{0,254}\\.service$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "expected_active_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Copy restart_preconditions.active_state exactly from the latest get_service response for this unit, e.g. \"active\". A display value such as \"active (running)\" is accepted only when its substate matches expected_sub_state."
        },
        "expected_sub_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Copy restart_preconditions.sub_state exactly from the same get_service response, e.g. \"running\"."
        },
        "expected_invocation_id": {
          "description": "Copy restart_preconditions.invocation_id exactly from the same get_service response. Never invent an ID or use the tool call ID. Omit only when invocation_id is absent from restart_preconditions.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "unit",
        "reason",
        "expected_active_state",
        "expected_sub_state"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "schemaVersion",
        "data"
