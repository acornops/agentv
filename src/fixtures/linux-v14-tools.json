                "unit",
                "outcome",
                "before",
                "after",
                "started_at",
                "completed_at",
                "systemd_job_result"
              ],
              "properties": {
                "operation_id": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "outcome": {
                  "enum": [
                    "success",
                    "failed",
                    "not_started",
                    "unknown"
                  ]
                },
                "before": {
                  "type": "object",
                  "required": [
                    "active_state",
                    "sub_state",
                    "invocation_id"
                  ],
                  "properties": {
                    "active_state": {
                      "type": "string"
                    },
                    "sub_state": {
                      "type": "string"
                    },
                    "invocation_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "after": {
                  "oneOf": [
                    {
