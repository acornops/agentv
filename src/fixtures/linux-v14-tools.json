  {
    "name": "query_logs",
    "description": "Query bounded normalized journald entries from locally allowed service units.",
    "capability": "read",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 9,
          "maxLength": 263,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]{0,254}\\.service$"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "since": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "until": {
          "type": "string",
          "format": "date-time",
