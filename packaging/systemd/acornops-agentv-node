#!/bin/bash
# Shared by the verified installer and installed entrypoints. Selection is data,
# never shell source, and is independent of the caller's PATH and Node preloads.

agentv_node_error() { echo "AgentV Node runtime: $*" >&2; return 1; }

agentv_node_secure_path() {
  local PATH=/usr/sbin:/usr/bin:/sbin:/bin
  local pending="$1" current=/ part link uid mode links=0
  [[ "${pending}" =~ ^/[a-zA-Z0-9._/-]+$ ]] || { agentv_node_error 'expected a system-wide absolute path'; return 1; }
  read -r uid mode < <(stat -c '%u %a' /)
  [[ "${uid}" == 0 && $((8#${mode} & 0022)) -eq 0 ]] || return 1
  pending="${pending#/}"
  while [[ -n "${pending}" ]]; do
    part="${pending%%/*}"
    if [[ "${pending}" == */* ]]; then pending="${pending#*/}"; else pending=""; fi
    case "${part}" in
      ''|.) continue ;;
      ..) current="${current%/*}"; current="${current:-/}"; continue ;;
    esac
    current="${current%/}/${part}"
    case "${current}" in
      /home|/root|/run/user) agentv_node_error "home-directory runtimes are unsupported: ${current}"; return 1 ;;
    esac
    if [[ -L "${current}" ]]; then
      [[ "$(stat -c '%u' "${current}")" == 0 ]] || { agentv_node_error "non-root-owned symlink: ${current}"; return 1; }
      links=$((links + 1))
      [[ "${links}" -le 40 ]] || { agentv_node_error 'too many symlink traversals'; return 1; }
      link="$(readlink "${current}")" || return 1
      [[ "${link}" =~ ^[a-zA-Z0-9._/-]+$ ]] || { agentv_node_error 'unsafe symlink target'; return 1; }
      current="${current%/*}"
      if [[ "${link}" == /* ]]; then current=/; link="${link#/}"; fi
      pending="${link}${pending:+/${pending}}"
      continue
    fi
    [[ -e "${current}" ]] || { agentv_node_error "missing path: ${current}"; return 1; }
    read -r uid mode < <(stat -c '%u %a' "${current}")
    [[ "${uid}" == 0 && $((8#${mode} & 0022)) -eq 0 ]] || {
      agentv_node_error "path must be root-owned and not group/world writable: ${current}"; return 1;
    }
    if [[ -n "${pending}" || -d "${current}" ]]; then
      [[ -d "${current}" && $((8#${mode} & 0001)) -ne 0 ]] || {
        agentv_node_error "path must be traversable by the service user: ${current}"; return 1;
      }
    fi
  done
  printf '%s\n' "${current}"
}

agentv_node_validate() {
  local PATH=/usr/sbin:/usr/bin:/sbin:/bin
  local candidate version mode
  candidate="$(agentv_node_secure_path "$1")" || return 1
  [[ -f "${candidate}" && -x "${candidate}" ]] || { agentv_node_error "not an executable file: ${candidate}"; return 1; }
  mode="$(stat -c '%a' "${candidate}")"
  [[ $((8#${mode} & 06005)) -eq 5 ]] || { agentv_node_error "runtime must be readable/executable by the service user without set-id bits: ${candidate}"; return 1; }
  version="$(env -u NODE_OPTIONS -u NODE_PATH "${candidate}" --version 2>/dev/null)" || {
    agentv_node_error "cannot execute runtime: ${candidate}"; return 1;
  }
  [[ "${version}" =~ ^v([0-9]{1,3})\.[0-9]+\.[0-9]+$ ]] && [[ "${BASH_REMATCH[1]}" -ge 22 ]] || {
    agentv_node_error "Node.js 22 or newer is required at ${candidate}"; return 1;
  }
  printf '%s\n' "${candidate}"
}

agentv_node_current() {
  local state=/opt/acornops/agentv/node-path
  local entries=()
  if [[ -e "${state}" || -L "${state}" ]]; then
    [[ -f "${state}" && ! -L "${state}" ]] || { agentv_node_error 'runtime selection must be a regular file'; return 1; }
    agentv_node_secure_path "${state}" >/dev/null || return 1
    mapfile -t entries < "${state}"
    [[ ${#entries[@]} -eq 1 ]] || { agentv_node_error 'invalid runtime selection file'; return 1; }
    agentv_node_validate "${entries[0]}"
  else
    # Installations predating runtime selection always used this exact path.
    agentv_node_validate /usr/bin/node
  fi
}

agentv_node_select() {
  local candidate result errors=""
  if [[ -e /opt/acornops/agentv/node-path || -L /opt/acornops/agentv/node-path ]]; then
    agentv_node_current
    return
  fi
  for candidate in /usr/bin/node /usr/local/bin/node; do
    if result="$(agentv_node_validate "${candidate}" 2>&1)"; then
      printf '%s\n' "${result}"
      return 0
    fi
    errors+="${result}"$'\n'
  done
  printf '%s' "${errors}" >&2
  agentv_node_error 'no trusted Node.js 22+ found; checked /usr/bin/node and /usr/local/bin/node'
}

agentv_node_save() {
  local PATH=/usr/sbin:/usr/bin:/sbin:/bin
  local selected state=/opt/acornops/agentv/node-path temporary
  [[ "$(id -u)" == 0 ]] || { agentv_node_error 'only root can select the runtime'; return 1; }
  selected="$(agentv_node_validate "$1")" || return 1
  agentv_node_secure_path "${state%/*}" >/dev/null || return 1
  temporary="$(mktemp "${state}.XXXXXX")" || return 1
  if ! { printf '%s\n' "${selected}" > "${temporary}" && chown root:root "${temporary}" && chmod 0644 "${temporary}" && mv -Tf "${temporary}" "${state}"; }; then
    rm -f -- "${temporary}"
    return 1
  fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  set -euo pipefail
  node_binary="$(agentv_node_current)"
  unset NODE_OPTIONS NODE_PATH
  exec "${node_binary}" "$@"
fi
